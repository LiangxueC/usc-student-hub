# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (optional — enables reminder emails)
# Project Settings → API → service_role key. Keep this secret.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
# Local:      http://localhost:5173,http://localhost:4173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# SMTP — optional, enables deadline reminder emails to group members
# Gmail: use an App Password (not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
